# Docker Compose reads this file after it is copied to .env.
# The standalone Java application reads shell environment variables instead.
HOST_PORT=8087
SITE_PUBLIC_URL=https://launcher.despical.dev
GOOGLE_ANALYTICS_ID=
GITHUB_RELEASE_SYNC_ENABLED=true
GITHUB_RELEASE_SYNC_INTERVAL=5m
SITE_ADMIN_USERNAME=admin
# Quote BCrypt hashes to preserve their dollar signs during Compose interpolation.
SITE_ADMIN_PASSWORD_HASH=''
# Use a long, unique database password.
DB_PASSWORD=
